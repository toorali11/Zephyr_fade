// 		    low-power-enable;
// 	    };
//     };


&pwm0 {
    pinctrl-0 = < &pwm0_own >;
	pinctrl-1 = < &pwm0_sleep1 >;
};

&pwm1 {
    status = "okay";
    pinctrl-0 = < &pwm1_own >;
	pinctrl-1 = < &pwm1_sleep1 >;
    pinctrl-names = "default",
				    "sleep";
};

&pwm2 {
    status = "okay";
    pinctrl-0 = < &pwm2_own >;
	pinctrl-1 = < &pwm2_sleep1 >;
    pinctrl-names = "default",
				    "sleep";
};

&pwm3 {
    status = "okay";
    pinctrl-0 = < &pwm3_own >;
	pinctrl-1 = < &pwm3_sleep1 >;
    pinctrl-names = "default",
				    "sleep";
};